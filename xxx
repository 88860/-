#!/bin/bash
# ==============================================================================
# Debian 13 (Trixie) Native Optimizer - zero new configuration files
#
# Principles:
#   - Debian 13 only
#   - Never create configuration files or drop-ins
#   - Detect the real system configuration chain first
#   - Persist only by editing an already-existing, actually-read admin file
#   - If a requested setting does not already exist, SKIP it instead of creating it
#   - No extra packages except wget/curl when explicitly required and missing
#   - BBR is only verified; this script does not create BBR config
#   - Logs are cleaned through journald/logrotate mechanisms plus safe truncation
#
# NOTE:
#   Debian 13 no longer honors /etc/sysctl.conf through systemd-sysctl.
#   This script therefore discovers the files actually read by systemd-sysctl
#   and never treats /etc/sysctl.conf as the persistence target merely because
#   it exists.
# ==============================================================================

set -Eeuo pipefail
shopt -s nullglob

readonly BLUE='\033[1;34m'
readonly GREEN='\033[1;32m'
readonly YELLOW='\033[1;33m'
readonly CYAN='\033[0;36m'
readonly GRAY='\033[1;37m'
readonly RED='\033[1;31m'
readonly NC='\033[0m'

export DEBIAN_FRONTEND=noninteractive

die() {
    echo -e "${RED}[FAIL] $*${NC}" >&2
    exit 1
}

info() { echo -e "${CYAN}>> $*${NC}"; }
pass() { echo -e "  ${GREEN}[PASS] $*${NC}"; }
skip() { echo -e "  ${GRAY}[SKIP] $*${NC}"; }
warn() { echo -e "  ${YELLOW}[WARN] $*${NC}"; }
fail() { echo -e "  ${RED}[FAIL] $*${NC}"; }

trap 'fail "命令失败: ${BASH_COMMAND} (line ${LINENO})"; exit 1' ERR

require_root() {
    [[ "${EUID:-}" -eq 0 ]] || die "请使用 root 权限运行"
}

check_debian13() {
    info "检测操作系统..."
    [[ -r /etc/os-release ]] || die "找不到 /etc/os-release"
    # shellcheck disable=SC1091
    . /etc/os-release

    if [[ "${ID:-}" != "debian" || "${VERSION_CODENAME:-}" != "trixie" ]]; then
        die "本脚本只允许 Debian 13 (Trixie)，当前: ${PRETTY_NAME:-unknown}"
    fi

    pass "确认 Debian 13 (Trixie): ${PRETTY_NAME}"
    pass "架构: $(dpkg --print-architecture)"
}

check_systemd() {
    info "检测 systemd..."
    command -v systemctl >/dev/null 2>&1 || die "systemctl 不存在"
    command -v systemd-analyze >/dev/null 2>&1 || die "systemd-analyze 不存在"
    command -v systemd-sysctl >/dev/null 2>&1 || die "systemd-sysctl 不存在"
    pass "systemd / systemd-analyze / systemd-sysctl 可用"
}

repair_dpkg_state() {
    info "检查 DPKG 状态..."
    if dpkg --audit >/dev/null 2>&1; then
        pass "DPKG 状态正常"
        return
    fi

    warn "发现未完成的 DPKG 状态，尝试 dpkg --configure -a"
    dpkg --configure -a
    dpkg --audit >/dev/null 2>&1 || die "DPKG 状态仍不正常"
    pass "DPKG 状态修复完成"
}

ensure_downloaders() {
    info "检查 wget / curl..."
    local missing=()
    command -v wget >/dev/null 2>&1 || missing+=("wget")
    command -v curl >/dev/null 2>&1 || missing+=("curl")

    if ((${#missing[@]} == 0)); then
        pass "wget: $(command -v wget)"
        pass "curl: $(command -v curl)"
        return
    fi

    echo -e "  ${YELLOW}[INFO] 缺少: ${missing[*]}，仅安装缺失工具${NC}"
    apt-get update -qq
    apt-get install -y --no-install-recommends "${missing[@]}"

    command -v wget >/dev/null 2>&1 || die "wget 安装后仍不可用"
    command -v curl >/dev/null 2>&1 || die "curl 安装后仍不可用"
    pass "wget / curl 已就绪"
}

apt_update_upgrade() {
    info "更新 Debian 13 软件包..."
    apt-get update -qq
    apt-get full-upgrade -y -qq \
        -o Dpkg::Options::="--force-confdef" \
        -o Dpkg::Options::="--force-confold" \
        --no-install-recommends
    pass "APT 更新完成"
}

# ------------------------------------------------------------------------------
# sysctl: discover actual systemd-sysctl configuration chain.
# Debian 13 does NOT use /etc/sysctl.conf as systemd-sysctl's normal source.
# ------------------------------------------------------------------------------

discover_sysctl_files() {
    SYSCTL_FILES=()

    local dirs=(
        /etc/sysctl.d
        /run/sysctl.d
        /usr/local/lib/sysctl.d
        /usr/lib/sysctl.d
    )
    local d f

    for d in "${dirs[@]}"; do
        [[ -d "$d" ]] || continue
        for f in "$d"/*.conf; do
            [[ -f "$f" ]] || continue
            SYSCTL_FILES+=("$f")
        done
    done

    mapfile -t SYSCTL_FILES < <(printf '%s\n' "${SYSCTL_FILES[@]}" | sort -u)

    ((${#SYSCTL_FILES[@]} > 0))
}

find_sysctl_assignment() {
    local key="$1"
    local f target=""

    for f in "${SYSCTL_FILES[@]}"; do
        if grep -qE "^[[:space:]]*${key}[[:space:]=]" "$f" 2>/dev/null; then
            target="$f"
        fi
    done

    printf '%s' "$target"
}

set_existing_sysctl() {
    local key="$1" value="$2"
    local target

    if ! sysctl -n "$key" >/dev/null 2>&1; then
        skip "内核不支持 $key"
        return 0
    fi

    target="$(find_sysctl_assignment "$key")"

    if [[ -z "$target" ]]; then
        skip "$key：实际读取的现有配置中不存在该项；不创建新配置"
        return 0
    fi

    echo -e "  ${CYAN}[FOUND] $key${NC}"
    echo -e "         ${GRAY}持久化文件: $target${NC}"

    # Only replace an existing assignment. Do not append.
    sed -i -E \
        "s|^[[:space:]]*${key}[[:space:]=].*|${key} = ${value}|" \
        "$target"

    local runtime
    sysctl -w "${key}=${value}" >/dev/null

    runtime="$(sysctl -n "$key")"
    [[ "$runtime" == "$value" ]] || die "$key runtime 验证失败: $runtime != $value"

    if grep -qE "^[[:space:]]*${key}[[:space:]=][[:space:]]*${value}[[:space:]]*$" "$target"; then
        pass "精准修改成功并已验证: $target -> $key = $value"
    else
        die "持久化验证失败: $target -> $key"
    fi
}

network_optimize() {
    info "探测 Debian 13 实际 sysctl 配置文件..."

    discover_sysctl_files || {
        warn "没有发现任何 sysctl.d 配置文件；遵守零新文件原则，不创建"
        return
    }

    echo -e "  ${GREEN}[FOUND] systemd-sysctl 配置链:${NC}"
    printf '      %s\n' "${SYSCTL_FILES[@]}"

    # Deliberately small, conservative set. No speculative TCP tuning.
    local pairs=(
        "net.core.default_qdisc|fq"
        "net.core.somaxconn|8192"
        "net.ipv4.tcp_max_syn_backlog|8192"
        "net.ipv4.ip_local_port_range|1024 65535"
    )

    info "检查 BBR..."
    local avail cc
    avail="$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null || true)"
    cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || true)"

    if [[ "$avail" == *bbr* ]]; then
        pass "当前运行内核提供 BBR (available: $avail)"
        echo -e "  ${GRAY}[INFO] 当前拥塞控制: ${cc:-unknown}${NC}"
        echo -e "  ${GRAY}[INFO] 不写入 BBR 配置；内核已有 BBR 支持${NC}"
    else
        skip "当前运行内核未提供 BBR；不创建任何 BBR 配置"
    fi

    local item key value
    for item in "${pairs[@]}"; do
        key="${item%%|*}"
        value="${item#*|}"
        set_existing_sysctl "$key" "$value"
    done

    info "重新加载 systemd-sysctl..."
    systemctl restart systemd-sysctl.service
    pass "systemd-sysctl 重新加载成功"

    # Re-check selected runtime values.
    for item in "${pairs[@]}"; do
        key="${item%%|*}"
        value="${item#*|}"
        if sysctl -n "$key" >/dev/null 2>&1; then
            echo -e "  ${GREEN}[VERIFY] $key = $(sysctl -n "$key")${NC}"
        fi
    done
}

# ------------------------------------------------------------------------------
# journald: use systemd's merged configuration view, then edit only an existing
# administrator-side assignment. Never create a drop-in.
# ------------------------------------------------------------------------------

discover_journald_admin_files() {
    JOURNAL_ADMIN_FILES=()

    local chain f
    chain="$(systemd-analyze cat-config systemd/journald.conf 2>/dev/null || true)"

    mapfile -t JOURNAL_CHAIN < <(
        printf '%s\n' "$chain" |
        awk '
            /^# / {
                x=$0
                sub(/^# /, "", x)
                if (x ~ /^\/(etc|run|usr\/local|usr)\/.*journald.*\.conf$/)
                    print x
            }
        ' | sort -u
    )

    for f in "${JOURNAL_CHAIN[@]}"; do
        [[ -f "$f" ]] || continue
        case "$f" in
            /etc/*) JOURNAL_ADMIN_FILES+=("$f") ;;
        esac
    done

    if ((${#JOURNAL_ADMIN_FILES[@]} == 0)) && [[ -f /etc/systemd/journald.conf ]]; then
        JOURNAL_ADMIN_FILES+=("/etc/systemd/journald.conf")
    fi
}

set_existing_journal() {
    local key="$1" value="$2"
    local target="" f

    for f in "${JOURNAL_ADMIN_FILES[@]}"; do
        [[ -f "$f" ]] || continue
        if grep -qE "^[[:space:]]*#?[[:space:]]*${key}=" "$f" 2>/dev/null; then
            target="$f"
        fi
    done

    if [[ -z "$target" ]]; then
        skip "$key：现有管理员配置没有该项，不创建"
        return
    fi

    echo -e "  ${CYAN}[FOUND] $key${NC}"
    echo -e "         ${GRAY}真实管理员配置: $target${NC}"

    sed -i -E \
        "s|^[[:space:]]*#?[[:space:]]*${key}=.*|${key}=${value}|" \
        "$target"

    grep -qE "^[[:space:]]*${key}=${value}$" "$target" ||
        die "journald 持久化验证失败: $key"

    pass "精准修改成功: $target -> $key=$value"
}

journal_cleanup() {
    info "检测 journald 实际配置链..."
    discover_journald_admin_files

    if ((${#JOURNAL_ADMIN_FILES[@]} > 0)); then
        echo -e "  ${GREEN}[FOUND] journald 管理员配置:${NC}"
        printf '      %s\n' "${JOURNAL_ADMIN_FILES[@]}"

        # Conservative limits; only modify settings that already exist.
        set_existing_journal "SystemMaxUse" "100M"
        set_existing_journal "SystemMaxFileSize" "10M"
        set_existing_journal "RuntimeMaxUse" "100M"
        set_existing_journal "RuntimeMaxFileSize" "10M"
        set_existing_journal "SystemMaxFiles" "10"
        set_existing_journal "RuntimeMaxFiles" "10"
        set_existing_journal "MaxRetentionSec" "7day"

        systemctl restart systemd-journald.service
        pass "journald 重新加载成功"
    else
        skip "没有可修改的 journald 管理员配置；不创建任何配置"
    fi

    info "使用 journalctl 官方机制清理历史 journal..."
    journalctl --rotate >/dev/null
    pass "journal rotate 完成"

    journalctl --vacuum-time=7d >/dev/null
    pass "删除超过 7 天的 archived journal"

    journalctl --vacuum-size=100M >/dev/null
    pass "将 archived journal 压缩到约 100M 上限"

    echo -e "  ${GREEN}[VERIFY] journal 占用:${NC}"
    journalctl --disk-usage
}

# ------------------------------------------------------------------------------
# logrotate: do not install it. If present, discover main/includes and only edit
# existing rules. Historical files are removed safely.
# ------------------------------------------------------------------------------

discover_logrotate() {
    LOGROTATE_FILES=()

    command -v logrotate >/dev/null 2>&1 || return 1
    [[ -f /etc/logrotate.conf ]] || return 1

    LOGROTATE_FILES+=("/etc/logrotate.conf")

    local inc f
    while IFS= read -r inc; do
        [[ -d "$inc" ]] || continue
        while IFS= read -r -d '' f; do
            LOGROTATE_FILES+=("$f")
        done < <(find "$inc" -maxdepth 1 -type f -print0)
    done < <(
        awk '
            /^[[:space:]]*include[[:space:]]+/ {
                print $2
            }
        ' /etc/logrotate.conf
    )

    mapfile -t LOGROTATE_FILES < <(
        printf '%s\n' "${LOGROTATE_FILES[@]}" | sort -u
    )
}

logrotate_cleanup() {
    info "检测 logrotate..."
    if ! discover_logrotate; then
        skip "系统没有可用的 logrotate 配置；不安装额外软件包"
        return
    fi

    echo -e "  ${GREEN}[FOUND] logrotate 实际配置文件:${NC}"
    printf '      %s\n' "${LOGROTATE_FILES[@]}"

    # Only change an already-existing global rotate rule.
    local target="" f
    for f in "${LOGROTATE_FILES[@]}"; do
        if grep -qE '^[[:space:]]*#?[[:space:]]*rotate[[:space:]]+[0-9]+' "$f" 2>/dev/null; then
            target="$f"
        fi
    done

    if [[ -n "$target" ]]; then
        echo -e "  ${CYAN}[FOUND] rotate -> $target${NC}"
        sed -i -E 's|^[[:space:]]*#?[[:space:]]*rotate[[:space:]]+[0-9]+.*$|rotate 3|' "$target"
        grep -qE '^[[:space:]]*rotate[[:space:]]+3[[:space:]]*$' "$target" &&
            pass "精准修改 rotate 3: $target"
    else
        skip "现有 logrotate 配置没有全局 rotate 参数；不创建"
    fi

    # Validate configuration without rotating anything.
    logrotate -d /etc/logrotate.conf >/dev/null 2>&1
    pass "logrotate 配置语法验证通过"

    # Remove already-rotated/compressed garbage under /var/log.
    local f deleted=0
    while IFS= read -r -d '' f; do
        if rm -f -- "$f"; then
            deleted=$((deleted + 1))
            echo -e "  ${GREEN}[DELETE] $f${NC}"
        fi
    done < <(
        find /var/log -xdev -type f \
            \( -name '*.gz' -o -name '*.xz' -o -name '*.bz2' -o \
               -name '*.zst' -o -name '*.lz4' -o \
               -name '*.1' -o -name '*.2' -o -name '*.3' -o \
               -name '*.4' -o -name '*.5' -o -name '*.6' -o \
               -name '*.7' -o -name '*.8' -o -name '*.9' \) \
            -print0 2>/dev/null
    )
    pass "已删除轮转/压缩历史日志: ${deleted} 个"
}

truncate_active_logs() {
    info "扫描 /var/log 活动普通日志..."
    local f count=0
    while IFS= read -r -d '' f; do
        case "$f" in
            *.journal|*.journal~) continue ;;
        esac

        # Only truncate files that are recognizably log-like.
        case "$f" in
            *.log|*.log.*|*/wtmp|*/btmp|*/lastlog|*/faillog|*/messages|*/syslog|*/auth.log|*/daemon.log|*/kern.log|*/user.log|*/debug)
                if [[ -s "$f" ]]; then
                    : > "$f"
                    count=$((count + 1))
                    echo -e "  ${GREEN}[TRUNCATE] $f -> 0 bytes${NC}"
                fi
                ;;
        esac
    done < <(find /var/log -xdev -type f -print0 2>/dev/null)

    pass "活动日志清理完成: ${count} 个文件"
}

log_optimize() {
    echo
    echo -e "${BLUE}====================================================${NC}"
    echo -e "${BLUE} Debian 13 日志探测 / 精准修改 / 清理${NC}"
    echo -e "${BLUE}====================================================${NC}"

    journal_cleanup
    logrotate_cleanup
    truncate_active_logs

    echo -e "${GREEN}✓ 日志模块完成；未创建任何配置文件${NC}"
}

# ------------------------------------------------------------------------------
# XanMod
# IMPORTANT: third-party repository necessarily needs persistent APT trust/source
# configuration. This option is therefore explicitly outside the zero-new-file
# guarantee. The native optimizer never invokes it.
# ------------------------------------------------------------------------------

install_xanmod() {
    echo
    echo -e "${BLUE}====================================================${NC}"
    echo -e "${BLUE} XanMod 第三方内核安装${NC}"
    echo -e "${BLUE}====================================================${NC}"

    warn "安装 XanMod 必须添加第三方 APT 源/密钥，因此会创建 APT 配置。"
    warn "这与“全脚本零新配置文件”原则冲突。"
    read -r -p "继续安装 XanMod？输入 YES 才继续: " answer < /dev/tty
    [[ "$answer" == "YES" ]] || {
        skip "已取消 XanMod 安装"
        return
    }

    apt-get update -qq

    command -v gpg >/dev/null 2>&1 || {
        warn "gpg 缺失，仅安装 gpg"
        apt-get install -y --no-install-recommends gpg
    }

    local keyring=/etc/apt/keyrings/xanmod-archive-keyring.gpg
    local repo=/etc/apt/sources.list.d/xanmod.list

    mkdir -p /etc/apt/keyrings

    if curl -fsSL https://dl.xanmod.org/archive.key |
        gpg --dearmor --yes -o "$keyring"; then
        pass "XanMod 官方密钥获取成功"
    else
        die "XanMod 密钥获取失败"
    fi

    cat > "$repo" <<EOF
deb [arch=amd64 signed-by=$keyring] http://deb.xanmod.org releases main
EOF
    pass "XanMod APT 源已配置: $repo"

    apt-get update -qq

    local variant="x64v1"
    if [[ -x /lib64/ld-linux-x86-64.so.2 ]]; then
        local detected
        detected="$(
            /lib64/ld-linux-x86-64.so.2 --help 2>/dev/null |
            grep -oE 'x86-64-v[1-4]' |
            sort -V |
            tail -n1 |
            sed 's/x86-64-/x64/'
        )"
        [[ -n "$detected" ]] && variant="$detected"
    fi

    echo -e "  ${CYAN}[INFO] CPU ABI 探测结果: $variant${NC}"
    apt-cache show "linux-xanmod-${variant}" >/dev/null 2>&1 ||
        die "仓库中没有 linux-xanmod-${variant}"

    apt-get install -y --no-install-recommends "linux-xanmod-${variant}"
    pass "XanMod 内核安装完成"

    echo -e "${YELLOW}>> 当前内核仍为: $(uname -r)${NC}"
    echo -e "${YELLOW}>> 重启后再次验证 BBR；本脚本不会额外写 BBR 配置${NC}"
}

cleanup_old_kernels() {
    echo
    echo -e "${BLUE}====================================================${NC}"
    echo -e "${BLUE} 安全清理旧内核${NC}"
    echo -e "${BLUE}====================================================${NC}"

    local current
    current="$(uname -r)"
    echo -e "  ${CYAN}[RUNNING] $current${NC}"

    info "执行 Debian APT 原生 autoremove..."
    apt-get autoremove --purge -y -qq
    pass "autoremove 完成"

    local old=()
    local pkg
    while IFS= read -r pkg; do
        [[ "$pkg" == *"$current"* ]] && continue
        old+=("$pkg")
    done < <(
        dpkg-query -W -f='${binary:Package}\n' 2>/dev/null |
        grep -E '^linux-(image|headers|modules)-' || true
    )

    if ((${#old[@]} == 0)); then
        pass "未发现可安全删除的旧 Debian/XanMod 内核包"
    else
        echo -e "${YELLOW}发现非当前运行内核包:${NC}"
        printf '  %s\n' "${old[@]}"
        read -r -p "删除这些内核包？输入 YES 才继续: " answer < /dev/tty
        if [[ "$answer" == "YES" ]]; then
            apt-get purge -y -- "${old[@]}"
            pass "旧内核包已删除"
        else
            skip "保留旧内核作为后备"
        fi
    fi

    if command -v update-grub >/dev/null 2>&1; then
        update-grub >/dev/null
        pass "GRUB 已更新"
    fi
}

clean_apt() {
    info "清理 APT 缓存和孤立依赖..."
    apt-get autoremove --purge -y -qq
    apt-get autoclean -y -qq
    apt-get clean -qq

    local rc
    rc="$(dpkg-query -W -f='${binary:Package} ${Status}\n' 2>/dev/null |
        awk '$2=="deinstall" && $4=="config-files" {print $1}')"

    if [[ -n "$rc" ]]; then
        xargs -r apt-get purge -y -qq <<< "$rc"
        pass "DPKG rc 残留已清理"
    else
        pass "没有 DPKG rc 残留"
    fi
}

final_audit() {
    echo
    echo -e "${BLUE}====================================================${NC}"
    echo -e "${BLUE} 最终系统状态验证${NC}"
    echo -e "${BLUE}====================================================${NC}"

    info "DPKG..."
    dpkg --audit >/dev/null 2>&1
    pass "DPKG 一致性正常"

    info "APT..."
    apt-get check >/dev/null 2>&1
    pass "APT 依赖正常"

    info "systemd..."
    systemctl is-system-running >/dev/null 2>&1 || {
        # degraded may be intentional on a fresh/minimal environment; show state.
        warn "systemd 当前状态: $(systemctl is-system-running 2>/dev/null || true)"
    }

    info "内核..."
    echo -e "  ${GREEN}[RUNNING] $(uname -r)${NC}"

    info "BBR..."
    local avail cc
    avail="$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null || true)"
    cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || true)"

    if [[ "$avail" == *bbr* ]]; then
        pass "内核提供 BBR；当前拥塞控制: ${cc:-unknown}"
    else
        skip "当前运行内核没有 BBR"
    fi

    info "/var/log..."
    du -sh /var/log 2>/dev/null || true

    info "journal..."
    journalctl --disk-usage 2>/dev/null || true

    echo
    echo -e "${GREEN}====================================================${NC}"
    echo -e "${GREEN}✓ Debian 13 优化流程完成${NC}"
    echo -e "${GREEN}✓ 没有通过原生优化模块创建新的配置文件${NC}"
    echo -e "${GREEN}✓ 只对已经存在的实际配置项进行持久化修改${NC}"
    echo -e "${GREEN}====================================================${NC}"
}

full_optimize() {
    apt_update_upgrade
    ensure_downloaders
    network_optimize
    log_optimize
    clean_apt
    final_audit
}

main() {
    require_root
    check_debian13
    check_systemd
    repair_dpkg_state

    while true; do
        echo
        echo -e "${CYAN}====================================================${NC}"
        echo -e "${CYAN} Debian 13 (Trixie) Native Optimizer${NC}"
        echo -e "${CYAN} 零新配置文件 / 实际配置探测 / 精准持久化${NC}"
        echo -e "${CYAN}====================================================${NC}"
        echo -e "${GREEN} 1.${NC} 全面优化：更新 + wget/curl + 网络 + 日志 + 清理 + 验证"
        echo -e "${GREEN} 2.${NC} 安装 XanMod：明确允许创建第三方 APT 配置"
        echo -e "${GREEN} 3.${NC} 清理旧内核"
        echo -e "${GREEN} 4.${NC} 仅日志探测 + 限制 + 清理"
        echo -e "${GREEN} 5.${NC} 仅系统更新 + 清理"
        echo -e "${RED} 0.${NC} 退出"
        echo -e "${CYAN}====================================================${NC}"

        local choice
        read -r -p "请输入 [0-5]: " choice < /dev/tty

        case "$choice" in
            1) full_optimize ;;
            2) install_xanmod ;;
            3) cleanup_old_kernels ;;
            4) log_optimize ;;
            5)
                apt_update_upgrade
                clean_apt
                final_audit
                ;;
            0)
                echo -e "${GRAY}已退出。${NC}"
                exit 0
                ;;
            *)
                echo -e "${RED}[FAIL] 无效输入${NC}"
                ;;
        esac
    done
}

main "$@"